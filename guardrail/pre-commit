#!/usr/bin/env bash
# Commit guardrail: block staged *content* that leaks PII / machine paths / private terms.
# Scans every staged .md file — memory repos keep files at the root or under memory/, so
# no path layout is assumed. Non-markdown infra is excluded.
#
# Built-in patterns are GENERIC (any home path, any email, a mount section) so THIS file
# carries no identifying info. Add your own private terms (employer, mount names, ...) via:
#   - env var:  export CLAUDE_CONFIG_DENYLIST="term1|term2"   (regex, |-separated)
#   - and/or an untracked denylist.local next to this hook    (one term/regex per line)
set -u

hookdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# generic, non-identifying leak signals: absolute home paths, any email, a mount section
generic='(/home/|/Users/)[a-z][a-z0-9._/-]*|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}|^\+## Mount:'

priv="${CLAUDE_CONFIG_DENYLIST:-}"
if [ -f "$hookdir/denylist.local" ]; then
  extra="$(grep -vE '^[[:space:]]*(#|$)' "$hookdir/denylist.local" | paste -sd'|' -)"
  [ -n "$extra" ] && priv="${priv:+$priv|}$extra"
fi
pattern="$generic${priv:+|$priv}"

files=()
while IFS= read -r f; do files+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$')
[ "${#files[@]}" -eq 0 ] && exit 0

added="$(git diff --cached -U0 --no-color -- "${files[@]}" | grep -E '^\+' | grep -vE '^\+\+\+')"
# drop known-safe SSH remote URLs (git@github.com etc.) so they don't trip the email pattern
leaks="$(printf '%s\n' "$added" | grep -nEi "$pattern" | grep -vEi 'git@(github|gitlab|bitbucket)\.')"

if [ -n "$leaks" ]; then
  { echo "✖ commit blocked — staged content looks like a private/machine leak:"
    printf '%s\n' "$leaks" | sed 's/^/   /'
    echo ""
    echo "Genericize or unstage. Override (discouraged): git commit --no-verify"
  } >&2
  exit 1
fi

# House style: no em-dashes in the reader-facing docs (README.md, docs/*.md).
# Same rule, same scope, as claude-session-kit: one habit serves both kits. Code,
# tests, memory files, and this hook keep theirs; only published prose is checked.
docfiles=()
for f in "${files[@]}"; do
  case "$f" in README.md|docs/*.md) docfiles+=("$f");; esac
done
if [ "${#docfiles[@]}" -gt 0 ]; then
  dashes="$(git diff --cached -U0 --no-color -- "${docfiles[@]}" | grep -E '^\+' | grep -vE '^\+\+\+' | grep -- '—')" || true
  if [ -n "$dashes" ]; then
    { echo "✖ commit blocked — added doc lines use an em-dash; house style is none in README/docs:"
      printf '%s\n' "$dashes" | sed 's/^/   /'
      echo ""
      echo "Use a period, comma, semicolon, colon, or parentheses instead. Override (discouraged): git commit --no-verify"
    } >&2
    exit 1
  fi
fi

# --- memory frontmatter lint: enforce naming convention + required fields ---
#
# Gated on being IN the memory store. It used to run in every repo this hook is
# wired into, including this kit's own checkout, where no memory file has ever
# lived: each new root-level document there had to be added to an exemption list,
# and that list grew into four copies in two lengths that disagreed with each
# other. Asking where we are replaces the list with a fact.
#
# Only this half is gated. The PII scan above runs everywhere, because a leak is a
# leak in any repo.
#
# lib.sh sits one directory up in every tree this hook runs from: the deployed
# kit, and this repo's own checkout. If it cannot be read, or the store cannot be
# resolved, the lint is skipped AND SAID SO. Skipping in silence is how a guard
# stops guarding without anyone noticing, and this is the last check before
# content becomes permanent history.
_gr_lib="$hookdir/../core/lib.sh"
if [ -r "$_gr_lib" ]; then
  . "$_gr_lib"
  # Resolved physically before comparing. git rev-parse always reports the real
  # path, while the setting holds whatever was written, so a store reached through
  # any symlink (/var on macOS, a linked home, a mounted volume) would compare
  # unequal and skip the lint without a word.
  _gr_logical="$(mk_memory_dir 2>/dev/null || printf '')"
  _gr_store="$(cd "$_gr_logical" 2>/dev/null && pwd -P || printf '')"
  _gr_top="$(git rev-parse --show-toplevel 2>/dev/null || printf '')"
  # The LOGICAL path too, separately. The write-time hook scopes its rules with its
  # own `case "$fp" in "$(mk_memory_dir)"/*`, which is the unresolved value, so a
  # file_path built from the resolved one would fall straight through that filter
  # and the rules keyed on the synced tier would never fire.
  _gr_guard="$hookdir/../hooks/memory-write-guard.sh"
else
  _gr_store=""; _gr_top=""; _gr_logical=""; _gr_guard=""
fi
if [ -z "$_gr_store" ] || [ -z "$_gr_top" ]; then
  echo "note: memory frontmatter lint skipped: could not tell whether this repo is the memory store" >&2
  echo "      (the PII scan above still ran; re-run install.sh if this repo should be linted)" >&2
  exit 0
fi
if [ ! -r "$_gr_guard" ] || ! command -v jq >/dev/null 2>&1; then
  echo "note: memory frontmatter lint skipped: the write-time hook or jq is not available here" >&2
  echo "      (the PII scan above still ran)" >&2
  exit 0
fi
[ "$_gr_top" = "$_gr_store" ] || exit 0

memfiles="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^(memory/)?[^/]+\.md$')"
# Handed to the write-time hook rather than re-checked here. This used to
# re-implement three of its seven rules by hand, which is how the two halves of the
# kit came to disagree about what a valid memory file is, and it left four rules
# with no check at any point: edit-over-write turns every change to an existing
# file into an Edit, and three rules only run on a Write because absence cannot be
# judged from a fragment. Commit time is the only place a whole file is ever seen.
#
# Staged content, never the worktree copy, or the lint judges something this commit
# does not contain.
bad=""
for f in $memfiles; do
  mk_is_nonmemory "$(basename "$f")" && continue
  _gr_why="$(git show ":$f" 2>/dev/null \
    | jq -Rs --arg p "$_gr_logical/$f" '{tool_input:{file_path:$p, content:.}}' 2>/dev/null \
    | bash "$_gr_guard" 2>/dev/null \
    | jq -r '.hookSpecificOutput.permissionDecisionReason // empty' 2>/dev/null)"
  [ -n "$_gr_why" ] && bad="$bad|$f: $_gr_why"
done
if [ -n "$bad" ]; then
  { echo "✖ commit blocked — memory frontmatter issues:"
    printf '%s' "$bad" | tr '|' '\n' | sed '/^$/d; s/^/   /'
    echo ""
    echo "These are the same rules the write-time hook applies; each message names the fix."
  } >&2
  exit 1
fi
exit 0
