{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/ensure-memory-symlink.sh\" 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/memory-delta-ping.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/edit-over-write.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/memory-review-reminder.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/feedback-proposals-ping.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "( \"$HOME/.claude/scripts/run-feedback-miner.sh\" >/dev/null 2>&1 & ) ; exit 0"
          }
        ]
      }
    ]
  }
}
